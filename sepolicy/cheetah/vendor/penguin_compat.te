# Types referenced by Penguin OS (AOSPA) policy that only exist on Qualcomm platforms
type vendor_sysfs_battery_supply, sysfs_type, fs_type;
type vendor_sysfs_usb_supply, sysfs_type, fs_type;

# Android 17 labels /sys/class/powercap as sysfs_powercap (gs201 used sysfs_thermal)
allow hal_thermal_default sysfs_powercap:dir r_dir_perms;
allow hal_thermal_default sysfs_powercap:file rw_file_perms;
allow hal_thermal_default sysfs_powercap:lnk_file read;
